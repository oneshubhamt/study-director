  "devDependencies": {
    "@marijn/find-cluster-break": "1.0.4",
    "acorn": "8.19.0",
    "axe-core": "4.14.0",
    "esbuild-wasm": "0.28.2",
    "style-mod": "4.1.4",
    "terser": "5.51.2"
  }
