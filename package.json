    "verify": "node build/verify-build.mjs",
    "test": "node tests/helpers/run-category.mjs fast",
    "test:targeted": "node tests/helpers/run-category.mjs targeted",
    "test:fast": "node tests/helpers/run-category.mjs fast",
    "test:unit": "node tests/helpers/run-category.mjs unit",
    "test:integration": "node tests/helpers/run-category.mjs integration",
    "test:architecture": "node tests/helpers/run-category.mjs architecture",
    "test:browser": "node tests/helpers/browser-suite.mjs smoke",
    "test:browser:extended": "node tests/helpers/browser-suite.mjs extended",
    "test:release:syntax": "node tests/architecture/build/syntax-check.mjs",
    "test:release:dependencies": "node tests/architecture/build/dependency-assurance.mjs",
    "test:release:rich-text-codecs": "node tests/integration/rich-text/wg1-codec.mjs",
    "test:release:performance": "node --max-old-space-size=1536 tests/integration/search/search-worker-extreme.mjs",
    "test:release:bundle": "node tests/architecture/build/rich-text-bundle.mjs",
    "test:release:generated-syntax": "node tests/architecture/build/generated-syntax-check.mjs",
    "test:release:minified": "node tests/architecture/build/verify-minified-release.mjs",
    "test:release:budgets": "node tests/architecture/build/performance-budgets.mjs",
    "test:release:compression": "node tests/architecture/build/terser-compression-contracts.mjs",
    "test:release": "npm run test:release:syntax && npm run test:release:dependencies && npm run test:release:deployment && npm run test:release:rich-text-codecs && node tests/integration/backup/binary-backup-capacity.mjs && npm run test:release:performance && npm run test:release:bundle && npm run build && npm run test:release:generated-syntax && npm run verify && npm run stage:firebase:minified && npm run test:release:minified && npm run test:release:budgets && npm run test:release:compression",
    "test:browser:feature": "node tests/helpers/browser-suite.mjs feature",
    "test:browser:release": "node tests/helpers/browser-suite.mjs release",
    "test:coverage": "node tests/helpers/coverage.mjs",
    "test:mutation": "node tests/helpers/mutation.mjs",
    "test:governance": "node tests/architecture/test-suite/suite-governance.mjs",
    "qa:promotion": "node tests/helpers/run-category.mjs fast && node tests/helpers/coverage.mjs && node tests/helpers/mutation.mjs && npm run test:coverage:branches && npm run test:release && npm run test:coverage:browser",
    "test:release:deployment": "node tests/architecture/build/deployment-contract.mjs",
    "test:coverage:branches": "node tests/helpers/branch-coverage.mjs",
    "test:coverage:browser": "node tests/helpers/browser-coverage.mjs"
