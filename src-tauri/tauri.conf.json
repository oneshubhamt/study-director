{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Director Tauri Spike",
  "identifier": "app.studydirector.taurispike",
  "build": {
    "beforeBuildCommand": "node build/stage-tauri.mjs",
    "frontendDist": "../dist/tauri"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Study Director — Tauri spike",
        "url": "index.html",
        "create": false,
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 500,
        "useHttpsScheme": true,
        "incognito": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; frame-src blob:; worker-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types sd-inert-html sd-assets sd-legal-html sd-insights-worker",
      "capabilities": [],
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../dist/tauri-resources/icon.ico",
      "../source/assets/icons/icon-512.png"
    ]
  }
}
